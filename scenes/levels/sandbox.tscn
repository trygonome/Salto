[sub_resource type="Shader" id="Shader_grid"]
code = "shader_type spatial;
// Sol de test : quadrillage d'un mètre pour juger les échelles.

uniform vec3 base_color : source_color = vec3(0.09, 0.15, 0.2);
uniform vec3 line_color : source_color = vec3(0.2, 0.38, 0.42);
uniform float cell_size = 1.0;

void fragment() {
	vec3 world = (INV_VIEW_MATRIX * vec4(VERTEX, 1.0)).xyz;
	vec2 coord = world.xz / cell_size;
	vec2 grid = abs(fract(coord - 0.5) - 0.5) / fwidth(coord);
	float line = 1.0 - min(min(grid.x, grid.y), 1.0);
	ALBEDO = mix(base_color, line_color, line);
	ROUGHNESS = 0.95;
}
"

