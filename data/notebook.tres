[gd_resource type="Resource" script_class="NotebookData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/night/notebook_data.gd" id="1_notebook"]

[resource]
script = ExtResource("1_notebook")
night_pages = Array[PackedInt32Array]([PackedInt32Array(1, 5, 6), PackedInt32Array(2, 3, 8), PackedInt32Array(4, 7), PackedInt32Array(10, 11), PackedInt32Array(9, 12)])
pages = PackedStringArray("Tout ce qui vit vibre : la voix, le tambour, la sève, et même la lumière. Les couleurs sont des chansons que l'œil entend.", "Une nuit sans lune, les Sourdines sont sorties de la brume. Elles boivent les vibrations comme d'autres boivent le sang.", "Là où une Sourdine se nourrit, le son meurt d'abord. Puis les couleurs pâlissent, et la sève s'arrête dans les arbres.", "Les tambours sont les derniers cœurs du village. Leur battement est trop fort pour elles : tant qu'ils battent, elles n'entrent pas.", "Les gongs des anciens sanctuaires gardent un morceau de chaque chanson. Rejoue-la, et ils se souviennent.", "Frappe une Sourdine assez fort et elle éclate. Tout ce qu'elle avait bu s'envole : un chant d'oiseau, un rire, une couleur.", "Les cornus foncent vers le moindre battement. Rien ne les affame plus qu'un tambour qui bat.", "Les volants ont appris à boire le vent. Écoute bien leurs ailes : elles ne font aucun bruit.", "Le Roi des Sourdines a bu le premier tambour du village. Depuis, il a faim de tout ce qui chante.", "Le Chef Taroum sait tout cela. Il n'en parle jamais, mais il danse plus fort chaque fois qu'un tambour revient.", "Les danseurs le savent : une danse est une vibration qu'on fait naître. Le corps devient tambour.", "Les Sourdines ne partiront jamais tout à fait. Elles attendent qu'on oublie de jouer. Alors il faut jouer encore, chaque nuit.")
